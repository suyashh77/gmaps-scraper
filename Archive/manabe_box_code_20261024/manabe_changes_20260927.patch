+    def acquire(self, worker_id: int) -> Optional[str]:
+        """Next account in rotation that no other worker currently holds.
+
+        Falls back to plain round-robin when every account is held, so a pool
+        smaller than the worker count still runs rather than stalling.
+        """
+        with self._lock:
+            if not self._pool:
+                return None
+            self._held.pop(worker_id, None)
+            busy = set(self._held.values())
+            for _ in range(len(self._pool)):
+                self._index %= len(self._pool)
+                path = self._pool[self._index]
+                self._index += 1
+                if path not in busy:
+                    self._held[worker_id] = path
+                    return path
+            self._index %= len(self._pool)
+            path = self._pool[self._index]
+            self._index += 1
+            self._held[worker_id] = path
+            return path
+
+    def release(self, worker_id: int) -> None:
+        with self._lock:
+            self._held.pop(worker_id, None)
